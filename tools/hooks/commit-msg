#!/bin/sh
# Checks that a commit message follows Conventional Commits (see CONTRIBUTING.md).
# Git runs it as the commit-msg hook (git config core.hooksPath tools/hooks); CI runs it
# for every commit and pull request title, so the rule lives in one place.
#   tools/hooks/commit-msg <file with the message>
set -eu
subject=$(sed -n '/^[^#]/{p;q;}' "$1")

case "$subject" in
  "Merge "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

pattern='^(feat|fix|docs|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: [^ ].*'
if printf '%s\n' "$subject" | grep -Eq "$pattern" && [ "${#subject}" -le 100 ]; then
  exit 0
fi

cat >&2 <<EOF
Commit message does not follow Conventional Commits:
  $subject

Format: <type>(<scope>): <description>   (at most 100 characters)
Types:  feat fix docs refactor perf test build ci chore revert
Example: fix(gitlab): count work items as issues
See CONTRIBUTING.md, "Commits and pull request titles".
EOF
exit 1
